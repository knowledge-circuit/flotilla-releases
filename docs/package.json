{
  "name": "flotilla-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "DOCS_BASE=/docs/ vite-react-ssg dev",
    "build": "vite-react-ssg build && pagefind --site dist",
    "preview": "vite preview",
    "check": "biome ci --diagnostic-level=error $(find src -type f \\( -name '*.ts' -o -name '*.tsx' \\))",
    "fix": "biome check --fix $(find src -type f \\( -name '*.ts' -o -name '*.tsx' \\))",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.0.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-router-dom": "^6.28.0",
    "vite-react-ssg": "^0.8.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@mdx-js/rollup": "^3.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "pagefind": "^1.1.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vite": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
